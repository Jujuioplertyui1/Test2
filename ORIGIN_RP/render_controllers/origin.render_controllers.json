  "controller.render.origin.rift_brute": {
   "geometry": "Geometry.default",
   "materials": [
    {
     "*": "Material.default"
    }
   ],
   "textures": [
    "Texture.default"
   ],
   "overlay_color": {
    "r": "1.0",
    "g": "query.property('origin:state') == 3 ? 0.82 : (query.property('origin:state') == 4 ? 0.45 : 0.06)",
    "b": "query.property('origin:state') == 3 ? 0.35 : (query.property('origin:state') == 4 ? 0.1 : 0.04)",
    "a": "(query.property('origin:state') == 1 || query.property('origin:state') == 4 || query.property('origin:state') == 5) ? (0.25 + 0.35 * math.abs(math.sin(query.life_time * 540))) : (query.property('origin:state') == 2 ? 0.6 : (query.property('origin:state') == 3 ? (0.16 + 0.08 * math.sin(query.life_time * 360)) : 0.0))"
   }
  },
