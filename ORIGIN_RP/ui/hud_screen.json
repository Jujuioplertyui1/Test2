{
 "namespace": "hud",
 "hud_screen": {
  "$screen_bg_content": "origin_ui.fullscreen_layer"
 },
 "hud_title_text": {
  "bindings": [
   {
    "binding_name": "#hud_title_text_string"
   },
   {
    "binding_type": "view",
    "source_property_name": "((((#hud_title_text_string - 'origin_hud') - 'origin_load') - 'origin_ncard') = #hud_title_text_string)",
    "target_property_name": "#visible"
   }
  ]
 },
 "root_panel": {
  "modifications": [
   {
    "array_name": "controls",
    "operation": "insert_back",
    "value": [
     {
      "origin_corner_hud@origin_ui.corner_hud": {}
     },
     {
      "origin_loading_alt@origin_ui.loading_screen_alt": {}
     },
     {
      "origin_nullscreen_alt@origin_ui.null_screen_alt": {}
     }
    ]
   }
  ]
 }
}