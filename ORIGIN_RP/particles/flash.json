{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "origin:flash",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/origin/particle/fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.14
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.size > 0 ? variable.size : 1.6) * (1 - variable.particle_age / variable.particle_lifetime * 0.4)",
          "(variable.size > 0 ? variable.size : 1.6) * (1 - variable.particle_age / variable.particle_lifetime * 0.4)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            112,
            16
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}