{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "origin:burst",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/origin/particle/fx"
   }
  },
  "components": {
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_rate_instant": {
    "num_particles": "14 + variable.emitter_random_1 * 8"
   },
   "minecraft:emitter_shape_sphere": {
    "radius": 0.2,
    "direction": "outwards"
   },
   "minecraft:particle_initial_speed": "2 + variable.particle_random_2 * 4",
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.3 + variable.particle_random_1 * 0.4"
   },
   "minecraft:particle_motion_dynamic": {
    "linear_drag_coefficient": 4
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "0.28 * (1 - variable.particle_age / variable.particle_lifetime) + 0.03",
     "0.05"
    ],
    "facing_camera_mode": "lookat_direction",
    "direction": {
     "mode": "derive_from_velocity",
     "min_speed_threshold": 0.01
    },
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      48,
      16
     ],
     "uv_size": [
      16,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
     "variable.color.a * (1 - variable.particle_age / variable.particle_lifetime)"
    ]
   }
  }
 }
}