{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "origin:ember",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/origin/particle/fx"
   }
  },
  "components": {
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_rate_instant": {
    "num_particles": "4 + variable.emitter_random_1 * 4"
   },
   "minecraft:emitter_shape_sphere": {
    "radius": 0.4,
    "direction": "outwards"
   },
   "minecraft:particle_initial_speed": 0.3,
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "1 + variable.particle_random_1 * 1.2"
   },
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     "math.sin(variable.particle_age * 300) * 0.6",
     1.2,
     "math.cos(variable.particle_age * 260) * 0.6"
    ],
    "linear_drag_coefficient": 1.5
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "0.05 + variable.particle_random_2 * 0.05",
     "0.05 + variable.particle_random_2 * 0.05"
    ],
    "facing_camera_mode": "rotate_xyz",
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      64,
      16
     ],
     "uv_size": [
      16,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
     "variable.color.a * ((1 - variable.particle_age / variable.particle_lifetime) * (0.6 + math.sin(variable.particle_age * 900) * 0.4))"
    ]
   }
  }
 }
}