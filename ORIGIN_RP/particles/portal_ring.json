{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "origin:portal_ring",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/origin/particle/hud"
   }
  },
  "components": {
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_rate_instant": {
    "num_particles": "math.max(24, variable.size * 26)"
   },
   "minecraft:emitter_shape_disc": {
    "radius": "variable.size",
    "surface_only": true,
    "plane_normal": [
     "variable.nx",
     0,
     "variable.nz"
    ],
    "direction": "outwards"
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "math.random(0.25, 0.45)"
   },
   "minecraft:particle_initial_speed": "math.random(0.1, 0.8)",
   "minecraft:particle_motion_dynamic": {
    "linear_drag_coefficient": 3
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     0.07,
     0.07
    ],
    "facing_camera_mode": "rotate_xyz",
    "uv": {
     "texture_width": 128,
     "texture_height": 256,
     "uv": [
      96,
      32
     ],
     "uv_size": [
      32,
      32
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
     "variable.color.a * (1 - variable.particle_age / variable.particle_lifetime)"
    ]
   }
  }
 }
}