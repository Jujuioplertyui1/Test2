{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "origin:petal",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/origin/particle/atlas2"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 4.5
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initial_speed": 0.2,
      "minecraft:particle_initial_spin": {
        "rotation": "variable.particle_random_1 * 360",
        "rotation_rate": "60 + variable.particle_random_2 * 120"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(variable.particle_age * 120) * 0.6",
          "-0.5",
          "math.cos(variable.particle_age * 90) * 0.4"
        ],
        "linear_drag_coefficient": 0.8
      },
      "minecraft:particle_motion_collision": {
        "collision_drag": 10,
        "coefficient_of_restitution": 0,
        "collision_radius": 0.05
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.09,
          0.09
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            96,
            32
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * math.clamp(2 - 2 * variable.particle_age / variable.particle_lifetime, 0, 1)"
        ]
      }
    }
  }
}