{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "origin:shards",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/origin/particle/fx"
   }
  },
  "components": {
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_rate_instant": {
    "num_particles": "8 + variable.emitter_random_1 * 6"
   },
   "minecraft:emitter_shape_sphere": {
    "radius": 0.2,
    "direction": "outwards"
   },
   "minecraft:particle_initial_speed": "2.5 + variable.particle_random_2 * 3",
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.8 + variable.particle_random_1 * 0.7"
   },
   "minecraft:particle_initial_spin": {
    "rotation": "variable.particle_random_3 * 360",
    "rotation_rate": "(variable.particle_random_4 - 0.5) * 720"
   },
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     -12,
     0
    ],
    "linear_drag_coefficient": 1
   },
   "minecraft:particle_motion_collision": {
    "collision_drag": 6,
    "coefficient_of_restitution": 0.3,
    "collision_radius": 0.05
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "0.08 + variable.particle_random_2 * 0.08",
     "0.1 + variable.particle_random_2 * 0.1"
    ],
    "facing_camera_mode": "rotate_xyz",
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      16,
      16
     ],
     "uv_size": [
      16,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
     "variable.color.a * (1 - variable.particle_age / variable.particle_lifetime * variable.particle_age / variable.particle_lifetime)"
    ]
   },
   "minecraft:particle_appearance_lighting": {}
  }
 }
}