{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "origin:static_dot",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/origin/particle/fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.5 + variable.particle_random_1 * 0.6"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "(variable.particle_random_2 - 0.5) * 0.4",
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.06 + variable.particle_random_3 * 0.06",
          "0.06 + variable.particle_random_3 * 0.06"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            16
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * (math.mod(math.floor(variable.particle_age * 12), 2) == 0 ? 1 : 0.4)"
        ]
      }
    }
  }
}