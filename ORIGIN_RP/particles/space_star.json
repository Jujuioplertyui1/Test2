{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "origin:space_star",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/origin/particle/space"
   }
  },
  "components": {
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.03
   },
   "minecraft:emitter_rate_instant": {
    "num_particles": "variable.n ?? 60"
   },
   "minecraft:emitter_shape_sphere": {
    "radius": "variable.r ?? 40",
    "surface_only": true,
    "direction": "outwards"
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "(variable.life ?? 2.2) * (0.8 + variable.particle_random_1 * 0.4)"
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "0.06 + variable.particle_random_2 * 0.12",
     "0.06 + variable.particle_random_2 * 0.12"
    ],
    "facing_camera_mode": "rotate_xyz",
    "uv": {
     "texture_width": 256,
     "texture_height": 128,
     "uv": [
      128,
      64
     ],
     "uv_size": [
      8,
      8
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "0.8 + variable.particle_random_3 * 0.2",
     "0.85 + variable.particle_random_3 * 0.15",
     "1",
     "math.min(1, math.sin(180 * variable.particle_age / variable.particle_lifetime) * 1.6)"
    ]
   }
  }
 }
}