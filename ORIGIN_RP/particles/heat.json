{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "origin:heat",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/origin/particle/fx"
   }
  },
  "components": {
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_rate_instant": {
    "num_particles": "2 + variable.emitter_random_1 * 2"
   },
   "minecraft:emitter_shape_point": {
    "direction": [
     "(variable.particle_random_3 - 0.5) * 0.3",
     "-1",
     "(variable.particle_random_4 - 0.5) * 0.3"
    ]
   },
   "minecraft:particle_initial_speed": "2 + variable.particle_random_2 * 2",
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.18 + variable.particle_random_1 * 0.12"
   },
   "minecraft:particle_motion_dynamic": {
    "linear_drag_coefficient": 3
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "0.16 * (1 - variable.particle_age / variable.particle_lifetime) + 0.04",
     "0.22 * (1 - variable.particle_age / variable.particle_lifetime) + 0.05"
    ],
    "facing_camera_mode": "rotate_xyz",
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      0,
      0
     ],
     "uv_size": [
      16,
      16
     ],
     "flipbook": {
      "base_UV": [
       0,
       0
      ],
      "size_UV": [
       16,
       16
      ],
      "step_UV": [
       16,
       0
      ],
      "frames_per_second": 16,
      "max_frame": 3,
      "stretch_to_lifetime": true
     }
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r + (1 - variable.color.r) * (1 - variable.particle_age / variable.particle_lifetime)",
     "variable.color.g + (1 - variable.color.g) * (1 - variable.particle_age / variable.particle_lifetime) * 0.8",
     "variable.color.b",
     "1 - variable.particle_age / variable.particle_lifetime"
    ]
   }
  }
 }
}