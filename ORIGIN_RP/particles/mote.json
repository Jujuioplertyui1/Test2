{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "origin:mote",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/origin/particle/fx"
   }
  },
  "components": {
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_rate_instant": {
    "num_particles": "3 + variable.emitter_random_1 * 3"
   },
   "minecraft:emitter_shape_sphere": {
    "radius": 0.8,
    "direction": "outwards"
   },
   "minecraft:particle_initial_speed": 0.15,
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "0.9 + variable.particle_random_1 * 0.9"
   },
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     "math.cos(variable.particle_age * 400) * 0.5",
     0.3,
     "math.sin(variable.particle_age * 400) * 0.5"
    ]
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "0.05 + math.sin(variable.particle_age * 700) * 0.02",
     "0.05 + math.sin(variable.particle_age * 700) * 0.02"
    ],
    "facing_camera_mode": "rotate_xyz",
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      32,
      16
     ],
     "uv_size": [
      16,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
     "variable.color.a * (1 - variable.particle_age / variable.particle_lifetime)"
    ]
   }
  }
 }
}