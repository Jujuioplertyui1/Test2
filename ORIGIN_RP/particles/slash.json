{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "origin:slash",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/origin/particle/atlas2"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.18
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initial_spin": {
        "rotation": "-30 + variable.particle_random_1 * 60"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "1.3 + variable.particle_age * 3",
          "1.3 + variable.particle_age * 3"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            32,
            64
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}