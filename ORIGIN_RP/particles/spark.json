     "mode": "derive_from_velocity",
     "min_speed_threshold": 0.01
    },
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      48,
      16
     ],
     "uv_size": [
      16,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
