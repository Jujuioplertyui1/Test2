{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "origin:void_swirl",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/origin/particle/atlas2"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 18
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.6
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "variable.k = 1 - variable.particle_age / variable.particle_lifetime; return math.cos(variable.particle_random_1 * 360 + variable.particle_age * 540) * 1.5 * variable.k;",
          "(variable.particle_random_2 - 0.5) * 1.2 * (1 - variable.particle_age / variable.particle_lifetime)",
          "math.sin(variable.particle_random_1 * 360 + variable.particle_age * 540) * 1.5 * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.13,
          0.13
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            112,
            16
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * math.sin(180 * variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}