{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "origin:beam_ring",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/origin/particle/sonic_boom"
   }
  },
  "components": {
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.02
   },
   "minecraft:emitter_rate_instant": {
    "num_particles": 1
   },
   "minecraft:emitter_shape_point": {},
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life ?? 0.35"
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "(variable.size ?? 1) * (0.5 + variable.particle_age / variable.particle_lifetime)",
     "(variable.size ?? 1) * (0.5 + variable.particle_age / variable.particle_lifetime)"
    ],
    "facing_camera_mode": "direction_z",
    "direction": {
     "mode": "custom",
     "custom_direction": [
      "variable.dx ?? 0",
      "variable.dy ?? 0",
      "variable.dz ?? 1"
     ]
    },
    "uv": {
     "texture_width": 128,
     "texture_height": 1280,
     "flipbook": {
      "base_UV": [
       0,
       0
      ],
      "size_UV": [
       128,
       128
      ],
      "step_UV": [
       0,
       128
      ],
      "frames_per_second": 20,
      "max_frame": 10,
      "stretch_to_lifetime": true,
      "loop": false
     }
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
     "variable.color.a * (1 - variable.particle_age / variable.particle_lifetime)"
    ]
   }
  }
 }
}