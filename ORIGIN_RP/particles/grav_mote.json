{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "origin:grav_mote",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/origin/particle/slash"
   }
  },
  "components": {
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_rate_instant": {
    "num_particles": 16
   },
   "minecraft:emitter_shape_sphere": {
    "radius": "variable.size ?? 3",
    "surface_only": true,
    "direction": "inwards"
   },
   "minecraft:particle_initial_speed": "(variable.size ?? 3) * 1.6",
   "minecraft:particle_motion_dynamic": {
    "linear_drag_coefficient": 0.8
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": 0.55
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     0.32,
     0.05
    ],
    "facing_camera_mode": "lookat_direction",
    "direction": {
     "mode": "derive_from_velocity",
     "min_speed_threshold": 0.001
    },
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      64,
      80
     ],
     "uv_size": [
      64,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
     "variable.color.a * (1 - variable.particle_age / variable.particle_lifetime)"
    ]
   }
  }
 }
}