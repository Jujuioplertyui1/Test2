{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "origin:asg_cloud",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/origin/particle/asgard"
   }
  },
  "components": {
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.03
   },
   "minecraft:emitter_rate_instant": {
    "num_particles": 1
   },
   "minecraft:emitter_shape_point": {
    "direction": [
     "math.random(-1, 1)",
     0,
     "math.random(-1, 1)"
    ]
   },
   "minecraft:particle_initial_speed": "math.random(0.1, 0.35)",
   "minecraft:particle_motion_dynamic": {},
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "math.random(9, 14)"
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "(variable.size ?? 4) * 1.33",
     "variable.size ?? 4"
    ],
    "facing_camera_mode": "rotate_xyz",
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      0,
      16
     ],
     "uv_size": [
      64,
      48
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
     "variable.color.a * math.sin(180 * variable.particle_age / variable.particle_lifetime)"
    ]
   }
  }
 }
}