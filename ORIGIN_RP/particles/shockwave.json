{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "origin:shockwave",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/origin/particle/fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.45
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.radius > 0 ? variable.radius : 2) * (0.25 + variable.particle_age / variable.particle_lifetime * 0.85)",
          "(variable.radius > 0 ? variable.radius : 2) * (0.25 + variable.particle_age / variable.particle_lifetime * 0.85)"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            64,
            32
          ],
          "uv_size": [
            16,
            16
          ],
          "flipbook": {
            "base_UV": [
              64,
              32
            ],
            "size_UV": [
              16,
              16
            ],
            "step_UV": [
              16,
              0
            ],
            "frames_per_second": 9,
            "max_frame": 3,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * ((1 - variable.particle_age / variable.particle_lifetime) * 1.2)"
        ]
      }
    }
  }
}