{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "origin:arc",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/origin/particle/atlas2"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 3
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.14
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.45
      },
      "minecraft:particle_initial_spin": {
        "rotation": "variable.particle_random_1 * 360"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.45,
          0.45
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            "80 + math.floor(variable.particle_random_2 * 2) * 16",
            16
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * math.clamp(2 - 2 * variable.particle_age / variable.particle_lifetime, 0, 1)"
        ]
      }
    }
  }
}