{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "origin:streak_glow",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/origin/particle/slash"
   }
  },
  "components": {
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_rate_instant": {
    "num_particles": 1
   },
   "minecraft:emitter_shape_point": {
    "direction": [
     "variable.dx ?? 1",
     "variable.dy ?? 0",
     "variable.dz ?? 0"
    ]
   },
   "minecraft:particle_initial_speed": "variable.spd ?? 1.5",
   "minecraft:particle_motion_dynamic": {
    "linear_drag_coefficient": 7
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life ?? 0.22"
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "(variable.len ?? 0.45) * 1.2",
     "(variable.w ?? 0.06) * 3.2"
    ],
    "facing_camera_mode": "lookat_direction",
    "direction": {
     "mode": "derive_from_velocity",
     "min_speed_threshold": 0.001
    },
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      64,
      80
     ],
     "uv_size": [
      64,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
     "variable.color.a * (1 - variable.particle_age / variable.particle_lifetime)"
    ]
   }
  }
 }
}