{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "origin:debris",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/origin/particle/atlas2"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 9
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.9 + variable.particle_random_1 * 0.5"
      },
      "minecraft:emitter_shape_disc": {
        "radius": 0.4,
        "plane_normal": [
          0,
          1,
          0
        ],
        "direction": [
          "math.random(-1,1)",
          "1.6",
          "math.random(-1,1)"
        ]
      },
      "minecraft:particle_initial_speed": "2.5 + variable.particle_random_2 * 2.5",
      "minecraft:particle_initial_spin": {
        "rotation": "variable.particle_random_3 * 360",
        "rotation_rate": "(variable.particle_random_1 - 0.5) * 720"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -18,
          0
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_motion_collision": {
        "collision_drag": 4,
        "coefficient_of_restitution": 0.35,
        "collision_radius": 0.08
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.12 + variable.particle_random_4 * 0.1",
          "0.12 + variable.particle_random_4 * 0.1"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            "math.floor(variable.particle_random_2 * 4) * 16",
            32
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * math.clamp(2 - 2 * variable.particle_age / variable.particle_lifetime, 0, 1)"
        ]
      }
    }
  }
}