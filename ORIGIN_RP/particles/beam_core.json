{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "origin:beam_core",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/origin/particle/beam"
   }
  },
  "components": {
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.02
   },
   "minecraft:emitter_rate_instant": {
    "num_particles": 1
   },
   "minecraft:emitter_shape_point": {
    "direction": [
     "variable.dx",
     "variable.dy",
     "variable.dz"
    ]
   },
   "minecraft:particle_initial_speed": "variable.spd ?? 0.04",
   "minecraft:particle_motion_dynamic": {},
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life ?? 0.12"
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.len ?? 1",
     "variable.w ?? 0.1"
    ],
    "facing_camera_mode": "lookat_direction",
    "direction": {
     "mode": "derive_from_velocity",
     "min_speed_threshold": 0.0001
    },
    "uv": {
     "texture_width": 64,
     "texture_height": 128,
     "uv": [
      0,
      0
     ],
     "uv_size": [
      64,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
     "variable.color.a * (1 - 0.35 * variable.particle_age / variable.particle_lifetime)"
    ]
   }
  }
 }
}