{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "origin:slash_arc",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/origin/particle/slash"
   }
  },
  "components": {
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_rate_instant": {
    "num_particles": 1
   },
   "minecraft:emitter_shape_point": {},
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": 0.22
   },
   "minecraft:particle_initial_spin": {
    "rotation": "variable.rot ?? math.random(-40, 40)",
    "rotation_rate": 0
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size ?? 1.6",
     "(variable.size ?? 1.6) * 0.5"
    ],
    "facing_camera_mode": "rotate_xyz",
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      0,
      0
     ],
     "uv_size": [
      128,
      64
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
     "variable.color.a * (1 - variable.particle_age / variable.particle_lifetime)"
    ]
   }
  }
 }
}