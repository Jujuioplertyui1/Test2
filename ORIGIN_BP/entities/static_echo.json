{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "origin:static_echo",
      "is_spawnable": false,
      "is_summonable": true
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "origin_echo",
          "monster",
          "mob"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.8
      },
      "minecraft:health": {
        "value": 12,
        "max": 12
      },
      "minecraft:attack": {
        "damage": 3
      },
      "minecraft:movement": {
        "value": 0.36
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:navigation.walk": {},
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 1,
        "must_see": false,
        "within_radius": 32,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "max_dist": 32
          }
        ]
      },
      "minecraft:behavior.melee_attack": {
        "priority": 2,
        "speed_multiplier": 1.3,
        "track_target": true
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6
      },
      "minecraft:loot": {
        "table": "loot_tables/empty.json"
      },
      "minecraft:timer": {
        "looping": false,
        "time": 60,
        "randomInterval": false,
        "time_down_event": {
          "event": "origin:fade",
          "target": "self"
        }
      }
    },
    "component_groups": {
      "origin:gone": {
        "minecraft:instant_despawn": {}
      }
    },
    "events": {
      "origin:fade": {
        "add": {
          "component_groups": [
            "origin:gone"
          ]
        }
      }
    }
  }
}